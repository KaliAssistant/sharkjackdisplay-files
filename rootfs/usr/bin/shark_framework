  fi
}

update_menu_labels() {
 # if [ "$menu_data_dirty" = "true" ] || [ -n "$1" ]; then
    menu_data_dirty=false

    if [ $current_menu = "menu_network_mode" ] || [ "$1" = "full" ]; then
      update_dhcp_menu
    fi
    if [ $current_menu = "menu_default_payload" ] || [ "$1" = "full" ]; then
      update_default_payload_menu
    fi
    if [ $current_menu = "menu_boot_network_mode" ] || [ "$1" = "full" ]; then
      update_boot_netmode_menu
    fi
    if [ $current_menu = "menu_armingmode_network_mode" ] || [ "$1" = "full" ]; then
      update_armingmode_network_mode_menu
    fi
    if [ $current_menu = "menu_wait_for_link" ] || [ "$1" = "full" ]; then
      update_wait_for_link_menu
    fi
    if [ $current_menu = "menu_autoexec" ] || [ "$1" = "full" ]; then
      update_autoexec_menu
    fi
    if [ $current_menu = "menu_ssh_server" ] || [ "$1" = "full" ]; then
      update_ssh_menu
    fi
    if [ $current_menu = "menu_armingmode_ssh_server" ] || [ "$1" = "full" ]; then
      update_armingmode_ssh_menu
    fi
    if [ $current_menu = "menu_ntp" ] || [ "$1" = "full" ]; then
      update_ntp_menu
    fi
    if [ $current_menu = "menu_backlight" ] || [ "$1" = "full" ]; then
      update_backlight_menu
    fi
    if [[ $current_menu == "menu_current_ssh" ]] || [[ "$1" == "full" ]]; then
      update_current_ssh_menu
    fi
    if [[ $current_menu == "menu_current_ntp" ]] || [[ "$1" == "full" ]]; then
      update_current_ntp_menu
    fi
    if [[ $current_menu == "menu_current_c2" ]] || [[ "$1" == "full" ]]; then
      update_current_c2_menu
    fi
    if [[ $current_menu == "menu_boot_mac" ]] || [[ "$1" == "full" ]]; then
      update_boot_mac_menu
    fi
    if [[ $current_menu == "menu_about_system" ]] || [[ "$1" == "full" ]]; then
      update_about_system_menu
    fi
    if [[ $current_menu == "menu_about_networking" ]] || [[ "$1" == "full" ]]; then
      update_about_networking_menu
    fi
    if [[ $current_menu == "menu_about_storage" ]] || [[ "$1" == "full" ]]; then
      update_about_storage_menu
    fi
    if [[ $current_menu == "menu_about_services" ]] || [[ "$1" == "full" ]]; then
      update_about_services_menu
    fi
    if [[ $current_menu == "menu_cloud_c2" ]] || [[ "$1" == "full" ]]; then
      update_cloud_c2_menu
    fi

    if [[ $current_menu == "menu_protected_arming" ]] || [[ "$1" == "full" ]]; then
      update_protected_arming_menu
    fi

    if [ $current_menu = "menu_theme" ] || [ "$1" = "full" ]; then
      update_theme_menu
    fi
    if [ $current_menu = "menu_screensaver_style" ] || [ "$1" = "full" ]; then
      update_screensaver_menu
    fi
#  fi
}

format_item_text() {
  local item="$1"
  local item_length=${#item}
  local item_centered
  local total_spaces
  local left_spaces
  local right_spaces

  if ((item_length > 16)); then
    item_centered="$item"
  else
    total_spaces=$((16 - item_length))
    left_spaces=$((total_spaces / 2))
    right_spaces=$((total_spaces - left_spaces))
    if ((total_spaces % 2 != 0)); then
      left_spaces=$((left_spaces + 1))
      right_spaces=$((right_spaces - 1))
    fi
    item_centered="$(printf '%*s%s%*s' "$left_spaces" '' "$item" "$right_spaces" '')"
  fi
  printf "$item_centered"
}

redraw_menu() {
  render_menu "$current_menu[@]"
}

menu_data_current_menu=""
render_menu() {
  if [ "$menu_data_current_menu" != "$current_menu" ]; then
    update_menu_labels
  fi
  menu_data_current_menu=$current_menu
#  if [ ${#menu_stack[@]} -gt 1 ]; then
#    update_menu_labels
#  else
#    menu_data_dirty=true
#  fi

  local menu_items=("${!1}")

  local top_indicator="."
  local bottom_indicator="."
  if [[ $visible_start -gt 0 ]]; then
    # top_indicator="               ↑"
    top_indicator="↑"
  fi
  if [[ $visible_end -lt $((${#menu_items[@]} - 1)) ]]; then
    # bottom_indicator="               ↓"
    bottom_indicator="↓"
  fi

  out=""
  for ((i = visible_start; i <= visible_end; i++)); do
    if [[ $i -lt ${#menu_items[@]} ]]; then
      if [[ $current_menu != "menu_about_"* ]]; then 
        local item="${menu_items[$i]%%:*}"  # Strip function/submenu part for display
      else
        local item="${menu_items[$i]}"
      fi
      if [[ $i -eq $selected_index ]]; then
        item_centered="$(format_item_text "$item")"
        out+="\n▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄"
        out+="\n\033[7m$item_centered\033[0m"
        out+="\n▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀"
      else
        item_centered="$(format_item_text "$item")"
        out+="\n"
        out+="\n$item_centered"
        out+="\n"
      fi
    fi
  done

  clear_screen
  screen_write "$top_indicator$out\n$bottom_indicator"
}

update_visible_window() {
  if [[ $selected_index -lt $visible_start ]]; then
    visible_start=$selected_index
    visible_end=$((visible_start + rows_visible))
  elif [[ $selected_index -gt $visible_end ]]; then
    visible_end=$selected_index
    visible_start=$((visible_end - rows_visible))
  fi
}

handle_input() {
  local menu_items=("${!1}")
  case "$2" in
    up)
      ((selected_index--))
      if [[ $selected_index -lt 0 ]]; then
        selected_index=$((${#menu_items[@]} - 1))
      fi
      update_visible_window
      ;;
    down)
      ((selected_index++))
      if [[ $selected_index -ge ${#menu_items[@]} ]]; then
        selected_index=0
      fi
      update_visible_window
      ;;
    select)
      handle_selection "$1"
      ;;
  esac
}

shark_animation_counter=0
shark_animation() {
  ((shark_animation_counter++))
  if [[ $shark_animation_counter -gt 5 ]]; then
    play_shark_animation
    shark_animation_counter=0
  fi
}

handle_selection() {
  local menu_items=("${!1}")
  local selected_option="${menu_items[$selected_index]}"
  local label="${selected_option%%:*}"  # Strip function/submenu part
  local action="${selected_option#*:}"  # Extract function/submenu part

  if [[ $label == "Version" ]]; then
    shark_animation
  fi
  if [[ $label == "← Back" ]] || [[ $label == "Back" ]] || [[ $label == "Main Menu" ]]; then
    pop_menu
  elif [[ "$(declare -p "$action" 2>/dev/null)" =~ "declare -a" ]]; then
    push_menu "$action"
  elif [[ "$(type -t "$action" 2>/dev/null)" == "function" ]]; then
    $action # Call the associated function
  fi
}

push_menu() {
  menu_stack+=("$current_menu")
  current_menu="$1"
  selected_index=0
  visible_start=0
  visible_end=$rows_visible
}

pop_menu() {
  if [[ ${#menu_stack[@]} -gt 0 ]]; then
    current_menu="${menu_stack[-1]}"
    menu_stack=("${menu_stack[@]:0:${#menu_stack[@]}-1}")
    selected_index=0
    visible_start=0
    visible_end=$rows_visible
  fi
}

go_back() {
  pop_menu
}

start_c2() {
  resp="$(CONFIRMATION_DIALOG "Start Cloud C² Client?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    C2CONNECT
    ALERT "C² Started!" 1 false
  fi
}

stop_c2() {
  resp="$(CONFIRMATION_DIALOG "Stop Cloud C² Client?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    C2DISCONNECT
    ALERT "C² Stopped!" 1 false
  fi
}

set_c2_enabled() {
  resp="$(CONFIRMATION_DIALOG "Enable Cloud C² on boot?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    SET_CONFIG_OPTION C2_ENABLED TRUE
    update_menu_labels "force"
    ALERT "C² Enabled At Boot!" 1 false
  fi
}

set_c2_disabled() {
  SET_CONFIG_OPTION C2_ENABLED FALSE
  update_menu_labels "force"
  ALERT "C² Disabled At Boot!" 1 false
}

deregister_c2() {
  resp="$(CONFIRMATION_DIALOG "Deregister Cloud C²?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    rm /etc/device.config
    ALERT "C² Deregistered!" 1 false
    set_c2_disabled
  fi
}

