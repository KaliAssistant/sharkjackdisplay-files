  resp=$(CONFIRMATION_DIALOG "Clear Loot?")
  if [ "$resp" = "Confirm" ];then
    rm -rf /root/loot/
    mkdir /root/loot
    ALERT "Loot Cleared!" 2 false
  fi
}

set_static_networking() {
    resp="$(STATIC_IP_MENU)"
    if [ "$resp" != "Back" ]; then
      CREATE_SPINNER "NETMODE STATIC"
      NETMODE STATIC
      STOP_SPINNER
    fi
}

set_led() {
  local selected_option="${menu_items[$selected_index]}"
  local label="${selected_option%%:*}"  # Strip function/submenu part
  echo "$label"
  LED $label
  ALERT "LED: ${label}" 2 false
  redraw_menu
}

btn_listen_for_user_input() {
  while true; do
    redraw_menu
    button_input=$(/usr/sbin/button_listener)
    if [ $? = 1 ]; then
      logger -t SharkFramework "FRAMEWORK FAILED TO LISTEN FOR BUTTON"
      ALERT "FATAL ERROR" "-1" true
      exit 1
    fi
    case "$button_input" in
      "switch-middle")
        handle_input "$current_menu[@]" "select"
        ;;
      "switch-left")
        handle_input "$current_menu[@]" "down"
        ;;
      "switch-right")
        handle_input "$current_menu[@]" "up"
        ;;
      *)
        ;;
    esac
  done
}

kbd_listen_for_user_input() {
  while true; do
    read -s -n 1 input
    case "$input" in
      w) EMULATE_BUTTON_PRESS "switch-right" "pressed";;
      s) EMULATE_BUTTON_PRESS "switch-left" "pressed";;
      d) EMULATE_BUTTON_PRESS "switch-right" "pressed";;
      a) EMULATE_BUTTON_PRESS "switch-left" "pressed";;
      e) EMULATE_BUTTON_PRESS "switch-middle";;
    esac
  done
}

ssh_kbd_help() {
  clear_screen
  echo -en "Running from SSH\n"
  echo -en "Interact using keyboard or device\n"
  echo "-----------------------------------\n"
  echo -en "w/d - navigate up/right\n"
  echo -en "s/a - navigate down/left \n"
  echo -en "e   - select enter/middle\n"
  echo "-----------------------------------\n"
  echo -en "press key to continue on keyboard\n"
  echo -en "WARNING: CHANGING THE NETMODE or network config remotely WILL INTURRUPT OR BREAK YOUR CONNECTION TO THIS DEVICE"
  read -s -n 1 input
}

disk_space_check() {
  logger -t Shark "Framework checking disk space"
  disk="$(df / | awk 'NR==2 {print $4}')"
  if [[ $disk -lt 1000 ]]; then
    ALERT "[!] LOW DISK SPACE" 3
  fi
}

PROTECTED_ARMING_MODE_PROMPT() {
  config_protected_mode="$(GET_CONFIG_OPTION PROTECTED_ARMING_MODE)"
  if [ "$config_protected_mode" = "TRUE" ];then
    logger -t Shark "PROTECTED ARMING MODE"
    configured_key="$(GET_CONFIG_OPTION PROTECTED_ARMING_MODE_PASS)"
    while [ "$resp" != "$configured_key" ]; do
      resp="$(NUMBER_PICKER "Passkey" "0-0-0-0")"
    done
    ALERT "Unlocked!" 1 false
  else
    logger -t Shark "UNPROTECTED ARMING MODE"
  fi
}

ARMING_MODE_STATE() {
  PROTECTED_ARMING_MODE_PROMPT
  CREATE_SPINNER "$(center_text "Entering")$(center_text "ARMING MODE")"
  # dont "hotswap" networking while being started interactively which will be remotely.
  if [ "$RESTARTED_INTERACTIVELY" = "true" ]; then
    STOP_SPINNER
    return
  fi
  if [ "$(cat /tmp/NETMODE)" != "$(GET_CONFIG_OPTION ARMING_MODE_NETMODE)" ]; then
    logger -t Shark "Framework Entering ARMING MODE NETMODE..."
    # do this optimization manually here because we do not want to disallow payloads to reconfigure mid-payload using NETMODE
    NETMODE "$(GET_CONFIG_OPTION ARMING_MODE_NETMODE)" &
  else
    logger -t Shark "Framework already in ARMING MODE NETMODE..."
  fi
  if [ "$config_armingmode_ssh" = "TRUE" ]; then
    logger -t Shark "Framework Starting SSH for ARMING MODE..."
    if [ "$(/etc/init.d/sshd status)" != "running" ]; then
      START_SSH &
    fi
  fi
  STOP_SPINNER
}

ARMING_MODE() {
  ARMING_MODE_STATE


  # Framework Startup ONLY
  logger -t Shark "Framework Starting Menu System..."
  if [ "$SSH_CONTEXT" = "true" ]; then
    ssh_kbd_help
    echo "sleep 10 && rm /tmp/interaction" | at now
    btn_listen_for_user_input &
    kbd_listen_for_user_input
  else
    echo "sleep 10 && rm /tmp/interaction" | at now
    btn_listen_for_user_input
  fi
}

parse_config() {
  config_autoexec="$(GET_CONFIG_OPTION AUTOEXEC)"
  config_autoexec_timeout="$(GET_CONFIG_OPTION AUTOEXEC_TIMEOUT)"
  config_autoexec_timeout_flash="$(GET_CONFIG_OPTION AUTOEXEC_TIMEOUT_FLASH)"
  config_armingmode_netmode="$(GET_CONFIG_OPTION ARMING_MODE_NETMODE)"
  config_armingmode_ssh="$(GET_CONFIG_OPTION ARMING_MODE_SSH)"
  config_ntp_enabled="$(GET_CONFIG_OPTION NTP_ENABLED)"
  config_c2_enabled="$(GET_CONFIG_OPTION C2_ENABLED)"
  config_theme="$(GET_CONFIG_OPTION THEME)"
  config_backlight="$(GET_CONFIG_OPTION BACKLIGHT)"
  config_ssh_enabled="$(GET_CONFIG_OPTION SSH_ENABLED)"
}

enforce_config_state() {
  use_configured_theme # via shark_helpers
  use_configured_backlight
}

swim() {
  logger -t Shark "Framework starting..."
  CREATE_SPINNER "Starting..."
  update_menu_labels "full"

  parse_config
  logger -t Shark "Framework enforcing config.txt state..."
  enforce_config_state

  logger -t Shark "Framework waiting for Boot Complete..."
  while [ ! -f /tmp/boot_complete ]; do
    sleep 0.5
  done

  disk_space_check
  LED B SLOW

  STOP_SPINNER


  ##################################
  # SSH or restarted during runtime or autoexec disabled in config.txt
  ##################################
  if [ "$SSH_CONTEXT" = "true" ] || [ -f /tmp/autoexec_prompted ] || [ "$config_autoexec" = "FALSE" ]; then
    logger -t Shark "Framework in SSH, restarted or autoexec disabled"
    ARMING_MODE
    exit 0 # early exit skip below
  fi

  ##################################
  # Normal execution (first run, not via SSH)
  ##################################
  # Prompt to cancel payload autoexec
  if [ "$config_autoexec" = "FALSE" ]; then
    logger -t Shark "Autoexec disabled, entering arming mode"
    ARMING_MODE
  else
    logger -t Shark "Framework prompting for autoexec cancellation..."
    LED R FAST
    if [ "$config_autoexec_timeout_flash" = "TRUE" ]; then
      resp="$(COUNTDOWN "Run Payload" "$config_autoexec_timeout" "" true)"
    else
      resp="$(COUNTDOWN "Run Payload" "$config_autoexec_timeout" "" false)"
    fi
    LED B SLOW
    touch /tmp/autoexec_prompted
    # User has interacted cancelling autoexec of the default/armed payload
    if [ "$resp" = "Cancelled" ]; then
      logger -t Shark "Framework autoexec cancelled, entering arming mode"
      ARMING_MODE
    else
      logger -t Shark "Framework autoexec, executing default payload"
      # default no argument execute_payload will find correct payload to launch in /root/payload/
      LED OFF
      execute_payload
      ARMING_MODE
    fi
  fi
}

swim
