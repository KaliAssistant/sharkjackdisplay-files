# Enable SSH at the init.d/system level regardless of attack/arming mode
enable_system_ssh() {
  resp="$(CONFIRMATION_DIALOG "Enable SSH on every boot?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    CREATE_SPINNER "Enabling SSH..."
    ENABLE_SSH
    config_ssh_enabled="TRUE"
    SET_CONFIG_OPTION SSH_ENABLED TRUE
    update_menu_labels "force"
    STOP_SPINNER
    ALERT "System SSH Enabled!" 2 false
  fi
}

# Disable SSH at the init.d/system level regardless of attack/arming mode
disable_system_ssh() {
  CREATE_SPINNER "Disabling SSH..."
  DISABLE_SSH
  config_ssh_enabled="FALSE"
  SET_CONFIG_OPTION SSH_ENABLED FALSE
  update_menu_labels "force"
  STOP_SPINNER
  ALERT "System SSH Disabled!" 2 false
}

# Enable SSH in ARMING MODE
enable_armingmode_ssh() {
  CREATE_SPINNER "Starting SSH..."
  START_SSH
  config_armingmode_ssh="TRUE"
  SET_CONFIG_OPTION ARMING_MODE_SSH TRUE
  update_menu_labels "force"
  STOP_SPINNER
  ALERT "ARMING MODE SSH Enabled!" 2 false
}

# Disable SSH in ARMING MODE
disable_armingmode_ssh() {
  resp="$(CONFIRMATION_DIALOG " Disable SSH in ARMING MODE?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    CREATE_SPINNER "Stopping SSH..."
    STOP_SSH
    config_armingmode_ssh="FALSE"
    SET_CONFIG_OPTION ARMING_MODE_SSH FALSE
    update_menu_labels "force"
    STOP_SPINNER
    ALERT "ARMING MODE SSH Disabled!" 2 false
  fi
}

start_ssh() {
  START_SSH
  update_menu_labels "force"
  ALERT "SSH Started!" 2 false
}

stop_ssh() {
  STOP_SSH
  update_menu_labels "force"
  ALERT "SSH Stopped!" 2 false
}

check_for_updates() {
  current_netmode="$(cat /tmp/NETMODE)"
  if [ "$current_netmode" = "STATIC" ] || [ "$current_netmode" = "DHCP_CLIENT" ]; then
    resp="$(UPDATE_FIRMWARE)"
    if [ "$resp" = "UPDATING" ]; then
      # updating
      exit 0
    fi
  else
    resp="$(LIST_PICKER "Enter NETMODE" "DHCP_CLIENT STATIC" "DHCP_CLIENT")"
    if [ "$resp" = "← Back" ]; then
      return
    fi
    CREATE_SPINNER "Changing NETMODE"
    NETMODE $resp
    STOP_SPINNER
    ALERT "Complete!" 1 false
    resp="$(UPDATE_FIRMWARE)"
    if [ "$resp" = "UPDATING" ]; then
      exit 0
    fi
    resp="$(OPTION_DIALOG "Return to $current_netmode?" " No " " Yes ")"
    if [ "$resp" = " Yes " ]; then
      CREATE_SPINNER "Changing NETMODE"
      NETMODE $current_netmode
      STOP_SPINNER
    fi
  fi
}

reboot_device() {
  reboot &
  BLOCKING_ALERT "Rebooting..." -1 false
}

