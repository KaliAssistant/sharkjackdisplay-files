set_ntp_enabled() {
  resp="$(CONFIRMATION_DIALOG "Enable NTP on every boot?" "Yes")"
  if [ "$resp" = "Yes" ]; then
    CREATE_SPINNER "Enabling NTP..."
    ENABLE_NTP
    SET_CONFIG_OPTION NTP_ENABLED TRUE
    config_ntp_enabled="TRUE"
    update_menu_labels "force"
    STOP_SPINNER
    ALERT "NTP ENABLED" 2 false
  fi
}

set_ntp_disabled() {
  CREATE_SPINNER "Disabling NTP..."
  DISABLE_NTP
  SET_CONFIG_OPTION NTP_ENABLED FALSE
  config_ntp_enabled="FALSE"
  update_menu_labels "force"
  STOP_SPINNER
  ALERT "NTP DISABLED" 2 false
}

sync_ntp() {
  current_netmode="$(cat /tmp/NETMODE)"
  if [ "$current_netmode" = "STATIC" ] || [ "$current_netmode" = "DHCP_CLIENT" ]; then
    CREATE_SPINNER "Syncing time"
    SYNC_TIME
    STOP_SPINNER
  else
    resp="$(LIST_PICKER "Enter NETMODE" "DHCP_CLIENT STATIC" "DHCP_CLIENT")"
    if [ "$resp" = "← Back" ]; then
      return
    fi
    netmode_changed=true
    CREATE_SPINNER "Changing NETMODE"
    NETMODE $resp
    STOP_SPINNER
    resp="$(WAIT_FOR_IP true)"
    if [ "$resp" != "Cancelled" ]; then
      CREATE_SPINNER "Syncing time"
      SYNC_TIME
      STOP_SPINNER
    fi
    resp="$(OPTION_DIALOG "Return to $current_netmode?" " No " " Yes ")"
    if [ "$resp" = " Yes " ]; then
      CREATE_SPINNER "Changing NETMODE"
      NETMODE $current_netmode
      STOP_SPINNER
    fi
  fi
}

launch_view_mac() {
  m="$(ip link show eth0 | awk '/ether/ {print $2}' | sed 's/://g')"
  ALERT "$m" -1 false
}

launch_mac_setter() {
  SET_MAC_MENU
}

launch_mac_changer() {
  resp="$(CONFIRMATION_DIALOG "Randomize MAC?")"
  if [ "$resp" = "Confirm" ];then
    RANDOMIZE_MAC
  fi
}

launch_confirm_factory_settings() {
  resp="$(CONFIRMATION_DIALOG "Reset All Settings?")"
  if [[ "$resp" == "Confirm" ]]; then
    resp=$(CONFIRMATION_DIALOG "This cannot be undone" "Ok")
    if [[ "$resp" == "Ok" ]]; then
      reset_to_factory_settings
    fi
  fi
}

launch_confirm_factory_reset() {
  resp="$(CONFIRMATION_DIALOG "Factory Reset?")"
  if [[ "$resp" == "Confirm" ]]; then
    resp=$(CONFIRMATION_DIALOG "This cannot be undone" "Okay")
    if [[ "$resp" == "Okay" ]]; then
      FACTORY_RESET
      resp=$?
      if [ "$resp" -eq 2 ]; then
        # kill framework to prevent further user input if we ever get this far
        exit 0
      fi
    fi
  fi
}

launch_get_payloads() {
  current_netmode="$(cat /tmp/NETMODE)"
  netmode_changed=false
  resp="$(CONFIRMATION_DIALOG "This will replace downloaded directory" "Okay")"
  if [ "$resp" = "Okay" ]; then
    if [ "$current_netmode" = "STATIC" ] || [ "$current_netmode" = "DHCP_CLIENT" ]; then
      GET_PAYLOADS
    else
      resp="$(LIST_PICKER "Enter NETMODE" "DHCP_CLIENT STATIC" "DHCP_CLIENT")"
      if [ "$resp" = "← Back" ]; then
        return
      fi
      netmode_changed=true
      CREATE_SPINNER "Changing NETMODE"
      NETMODE $resp
      STOP_SPINNER
      ALERT "Complete!" 1 false
      resp=$(WAIT_FOR_IP true)
      if [ "$resp" = "Cancelled" ];then
        ALERT "Cancelled" 2 false
        return
      fi
      GET_PAYLOADS
      if [ $netmode_changed = "true" ]; then
        resp="$(OPTION_DIALOG "Return to $current_netmode?" " No " " Yes ")"
        if [ "$resp" = " Yes " ]; then
          CREATE_SPINNER "Changing NETMODE"
          NETMODE $current_netmode
          STOP_SPINNER
        fi
      fi
      # update_menu_labels "full"
    fi
  fi
}

remove_armed_payload() {
  resp=$(CONFIRMATION_DIALOG "Remove Payload?" "Remove")
  if [[ "$resp" == "Remove" ]]; then
    resp=$(CONFIRMATION_DIALOG "This cannot be undone" "Ok")
    if [[ "$resp" == "Ok" ]]; then
      rm -rf /root/payload/*
    fi
  fi
}

launch_armed_payload() {
  resp=$(CONFIRMATION_DIALOG "Run Armed Payload" " Run ")
  if [[ "$resp" == " Run " ]]; then
    payload="${1:-$(find "${SELECTED_ITEM_DATA}"/payload* 2>/dev/null | tail -n1)}"
    CREATE_SPINNER "Starting Payload..."
    if [ "$config_ssh_enabled" = "FALSE" ]; then
      STOP_SSH
    fi
    sleep 0.5
    LED OFF
    STOP_SPINNER
    rm /tmp/restart_payload 2&>1 >/dev/null # just to be safe
    execute_payload
    while [ -f "/tmp/restart_payload" ]; do
      rm /tmp/restart_payload  2&>1 >/dev/null
      ALERT "Restarting Payload..." 1 false
      execute_payload
    done
    rm /tmp/restart_payload 2&>1 >/dev/null # just to be safe
    ARMING_MODE_STATE # resume arming mode configuraion (netmode, ssh)
  fi
}

launch_payload_menu() {
  resp=$(PAYLOAD_MENU)
  if [[ -n "$resp" && "$resp" != "Back" && "$resp" != "← Back" ]]; then
    # ALERT "\n\n$(center_text "Starting")\n\n$(center_text "Payload")\n\n" 1 false true
    CREATE_SPINNER "Starting Payload..."
    if [ "$config_ssh_enabled" = "FALSE" ]; then
      STOP_SSH
    fi
    sleep 0.5
    LED OFF
    STOP_SPINNER
    rm /tmp/restart_payload 2&>1 >/dev/null # just to be safe
    execute_payload "$resp"
    while [ -f "/tmp/restart_payload" ]; do
      rm /tmp/restart_payload 2&>1 >/dev/null # just to be safe
      ALERT "Restarting Payload..." 1 false
      execute_payload "$resp"
    done
    rm /tmp/restart_payload 2&>1 >/dev/null # just to be safe
    ARMING_MODE_STATE # resume arming mode configuraion (netmode, ssh)
  fi
  redraw_menu
}

launch_loot_menu() {
  LOOT_MENU
  redraw_menu
}

launch_clients_menu() {
  CLIENTS_MENU
  redraw_menu
}

launch_shark_link() {
  current_netmode="$(cat /tmp/NETMODE)"
  netmode_changed=false
  if [ "$current_netmode" = "STATIC" ] || [ "$current_netmode" = "DHCP_CLIENT" ]; then
    SHARK_LINK
  else
   resp="$(LIST_PICKER "Enter NETMODE" "DHCP_CLIENT STATIC" "DHCP_CLIENT")"
   if [ "$resp" != "← Back" ]; then
     CREATE_SPINNER "Changing NETMODE"
     current_netmode="$(cat /tmp/NETMODE)"
     NETMODE $resp
     STOP_SPINNER
     ALERT "Complete!" 1 false
     SHARK_LINK
     resp="$(OPTION_DIALOG "Return to $current_netmode?" " No " " Yes ")"
     if [ "$resp" = " Yes " ]; then
        CREATE_SPINNER "Changing NETMODE"
        NETMODE $current_netmode
        STOP_SPINNER
      fi
   fi
  fi
  sleep 0.1
  redraw_menu
}

launch_configure_shark_link() {
  SHARK_LINK true
}

set_protected_arming_enabled() {
  pass="$(NUMBER_PICKER "Passkey" "0-0-0-0")"
  if [ "$pass" != "← Back" ]; then
    passtwo="$(NUMBER_PICKER "Confirm code" "0-0-0-0")"
    if [ "$passtwo" != "← Back" ]; then
      if [ "$pass" = "$passtwo" ]; then
        resp="$(CONFIRMATION_DIALOG "DO NOT LOSE THIS CODE" "I Agree")"
        if [ "$resp" = "I Agree" ]; then
          SET_CONFIG_OPTION PROTECTED_ARMING_MODE "TRUE"
          SET_CONFIG_OPTION PROTECTED_ARMING_MODE_PASS $passtwo
          update_menu_labels "force"
          ALERT "PASS SET!" 2 false
        fi
      else
        resp="$(ALERT "Codes did not match" -1 false)"
      fi
    fi
  fi
}

set_protected_arming_disabled() {
  SET_CONFIG_OPTION PROTECTED_ARMING_MODE "FALSE"
  SET_CONFIG_OPTION PROTECTED_ARMING_MODE_PASS "0-0-0-0"
  update_menu_labels "force"
  ALERT "PASS DISABLED!" 2 false
}

