  config_backlight="$(GET_CONFIG_OPTION BACKLIGHT)"
  if [[ $config_backlight == "TRUE" ]]; then
    menu_backlight=("[Enabled]:enable_backlight" "Disable:disable_backlight" "← Back")
  else
    menu_backlight=("Enable:enable_backlight" "[Disabled]:disable_backlight" "← Back")
  fi
}

update_autoexec_menu() {
  config_autoexec="$(GET_CONFIG_OPTION AUTOEXEC)"
  if [[ $config_autoexec == "TRUE" ]]; then
    menu_autoexec=("[Enabled]:enable_autoexec" "Disable:disable_autoexec" "← Back")
  else
    menu_autoexec=("Enable:enable_autoexec" "[Disabled]:disable_autoexec" "← Back")
