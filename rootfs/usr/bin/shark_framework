update_dhcp_menu() {
  netmode=$(cat /tmp/NETMODE 2>/dev/null || echo "OFF")
  case "$netmode" in
    AUTO)
      menu_network_mode=("[AUTO]:netmode_auto" "DHCP Server:netmode_dhcp_server" "DHCP Client:netmode_dhcp_client" "STATIC:netmode_static" "OFF:netmode_off" "← Back")
      ;;
    DHCP_SERVER)
      menu_network_mode=("AUTO:netmode_auto" "[DHCP Server]:netmode_dhcp_server" "DHCP Client:netmode_dhcp_client" "STATIC:netmode_static" "OFF:netmode_off" "← Back")
      ;;
    DHCP_CLIENT)
      menu_network_mode=("AUTO:netmode_auto" "DHCP Server:netmode_dhcp_server" "[DHCP Client]:netmode_dhcp_client" "STATIC:netmode_static" "OFF:netmode_off" "← Back")
      ;;
    STATIC)
      menu_network_mode=("AUTO:netmode_auto" "DHCP Server:netmode_dhcp_server" "DHCP Client:netmode_dhcp_client" "[STATIC]:netmode_static" "OFF:netmode_off" "← Back")
      ;;
    OFF)
      menu_network_mode=("AUTO:netmode_auto" "DHCP Server:netmode_dhcp_server" "DHCP Client:netmode_dhcp_client" "STATIC:netmode_static" "[OFF]:netmode_off" "← Back")
      ;;
  esac
}

update_boot_netmode_menu() {
  netmode="$(GET_CONFIG_OPTION BOOT_NETMODE)"
  case "$netmode" in
    DHCP_SERVER)
      menu_boot_network_mode=("OFF:boot_netmode_off" "[DHCP Server]:boot_netmode_dhcp_server" "DHCP Client:boot_netmode_dhcp_client" "STATIC:boot_netmode_static" "← Back")
      ;;
    DHCP_CLIENT)
      menu_boot_network_mode=("OFF:boot_netmode_off" "DHCP Server:boot_netmode_dhcp_server" "[DHCP Client]:boot_netmode_dhcp_client" "STATIC:boot_netmode_static" "← Back")
      ;;
    STATIC)
      menu_boot_network_mode=("OFF:boot_netmode_off" "DHCP Server:boot_netmode_dhcp_server" "DHCP Client:boot_netmode_dhcp_client" "[STATIC]:boot_netmode_static" "← Back")
      ;;
    OFF)
      menu_boot_network_mode=("[OFF]:boot_netmode_off" "DHCP Server:boot_netmode_dhcp_server" "DHCP Client:boot_netmode_dhcp_client" "STATIC:boot_netmode_static" "← Back")
      ;;
  esac
}

update_armingmode_network_mode_menu() {
  netmode="$(GET_CONFIG_OPTION ARMING_MODE_NETMODE)"
  case "$netmode" in
    DHCP_SERVER)
      menu_armingmode_network_mode=("[DHCP Server]:armingmode_netmode_dhcp_server" "DHCP Client:armingmode_netmode_dhcp_client" "STATIC:armingmode_netmode_static" "OFF:armingmode_netmode_off" "← Back")
      ;;
    DHCP_CLIENT)
      menu_armingmode_network_mode=("DHCP Server:armingmode_netmode_dhcp_server" "[DHCP Client]:armingmode_netmode_dhcp_client" "STATIC:armingmode_netmode_static" "OFF:armingmode_netmode_off" "← Back")
      ;;
    STATIC)
      menu_armingmode_network_mode=("DHCP Server:armingmode_netmode_dhcp_server" "DHCP Client:armingmode_netmode_dhcp_client" "[STATIC]:armingmode_netmode_static" "OFF:armingmode_netmode_off" "← Back")
      ;;
    OFF)
      menu_armingmode_network_mode=("DHCP Server:armingmode_netmode_dhcp_server" "DHCP Client:armingmode_netmode_dhcp_client" "STATIC:armingmode_netmode_static" "[OFF]:armingmode_netmode_off" "← Back")
      ;;
  esac
}


