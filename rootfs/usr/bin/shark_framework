render_connection_check_ip_picker() {
  config_connection_check_ip="$(GET_CONFIG_OPTION CONNECTION_CHECK_IP)"
  ip="$(/usr/bin/NUMBER_PICKER "IP" "$(pad_ip $config_connection_check_ip)")"
  if [ "$ip" = "← Back" ]; then
    return
  fi
  ip="$(validate_and_strip_ip "$ip")"
  if [ -z "$ip" ]; then
    ALERT "Invalid IP" 3
    return
  fi
  conf="$(CONFIRMATION_DIALOG "$ip")"
  if [ "$conf" != "Confirm" ]; then
    return
  fi
  ALERT "Complete!" 2 false
  SET_CONFIG_OPTION CONNECTION_CHECK_IP "$ip"
}

render_connection_check_domain_picker() {
  config_connection_check_domain="$(GET_CONFIG_OPTION CONNECTION_CHECK_DOMAIN)"
  domain="$(TEXT_PICKER "Domain" "$(center_text $config_connection_check_domain)")"
  if [ "$domain" = "← Back" ]; then
   return 
  fi
  sanitized="$(validate_domain "$domain")"
  if [ "$sanitized" = "invalid" ]; then
    ALERT "Invalid domain" 3
    return
  else
    SET_CONFIG_OPTION CONNECTION_CHECK_DOMAIN "$sanitized"
    update_menu_labels "force"
    ALERT "Complete!" 2 false
  fi
}

render_screensaver_timeout_menu() {
  config_screensaver_timeout="$(GET_CONFIG_OPTION SCREENSAVER_TIMEOUT)m"
  resp=""
  case "$config_screensaver_timeout" in
    "2")
      resp="$(LIST_PICKER "Timeout" "[2m] 3m 4m 5m 10m 15m 30m" "[2m]")"
      ;;
    "3")
      resp="$(LIST_PICKER "Timeout" "2m [3m] 4m 5m 10m 15m 30m" "[3m]")"
      ;;
    "4")
      resp="$(LIST_PICKER "Timeout" "2m 3m [4m] 5m 10m 15m 30m" "[4m]")"
      ;;
    "5")
      resp="$(LIST_PICKER "Timeout" "2m 3m 4m [5m] 10m 15m 30m" "[5m]")"
      ;;
    "10")
      resp="$(LIST_PICKER "Timeout" "2m 3m 4m 5m [10m] 15m 30m" "[10m]")"
      ;;
    "15")
      resp="$(LIST_PICKER "Timeout" "2m 3m 4m 5m 10m [15m] 30m" "[15m]")"
      ;;
    "30")
      resp="$(LIST_PICKER "Timeout" "2m 3m 4m 5m 10m 15m [30m]" "[30m]")"
      ;;
     *)
      resp="$(LIST_PICKER "Timeout" "2m 3m 4m [5m] 10m 15m 30m" "[5m]")"
      ;;
  esac
  if [ "$resp" != "← Back" ]; then
    set_screensaver_timeout "$resp"
  fi
}

render_autoexec_timeout_menu() {
  config_autoexec_timeout="$(GET_CONFIG_OPTION AUTOEXEC_TIMEOUT)s"
  resp=""
  case "$config_autoexec_timeout" in
    "2s")
      resp="$(LIST_PICKER "Timeout" "[2s] 3s 4s 5s 10s 15s 30s 60s" "[2s]")"
      ;;
    "3s")
      resp="$(LIST_PICKER "Timeout" "2s [3s] 4s 5s 10s 15s 30s 60s" "[3s]")"
      ;;
    "4s")
      resp="$(LIST_PICKER "Timeout" "2s 3s [4s] 5s 10s 15s 30s 60s" "[4s]")"
      ;;
    "5s")
      resp="$(LIST_PICKER "Timeout" "2s 3s 4s [5s] 10s 15s 30s 60s" "[5s]")"
      ;;
    "10s")
      resp="$(LIST_PICKER "Timeout" "2s 3s 4s 5s [10s] 15s 30s 60s" "[10s]")"
      ;;
    "15s")
      resp="$(LIST_PICKER "Timeout" "2s 3s 4s 5s 10s [15s] 30s 60s" "[15s]")"
      ;;
    "30s")
      resp="$(LIST_PICKER "Timeout" "2s 3s 4s 5s 10s 15s [30s] 60s" "[30s]")"
      ;;
    "60s")
      resp="$(LIST_PICKER "Timeout" "2s 3s 4s 5s 10s 15s 30s [60s]" "[60s]")"
      ;;
     *)
      resp="$(LIST_PICKER "Timeout" "2s [3s] 4s 5s 10s 15s 30s 60s" "[3s]")"
      ;;
  esac
  if [ "$resp" != "← Back" ]; then
    set_autoexec_timeout "$resp"
  fi
}

render_autoexec_timeout_flash_menu() {
  config_autoexec_timeout_flash="$(GET_CONFIG_OPTION AUTOEXEC_TIMEOUT_FLASH)"
  if [ "$config_autoexec_timeout_flash" = "TRUE" ]; then
    resp="$(OPTION_DIALOG "Flash Screen on countdown?" "FALSE" "[TRUE]")"
  else
    resp="$(OPTION_DIALOG "Flash Screen on countdown?" "[FALSE]" "TRUE")"
  fi
  set_autoexec_timeout_flash "$resp"
}

# this menu shows system default (boot aka arming/attackmode agnostic) ssh service
update_ssh_menu() {
  config_ssh_enabled="$(GET_CONFIG_OPTION SSH_ENABLED)"
  if [[ $config_ssh_enabled == "TRUE" ]]; then
      menu_ssh_server=("[Enabled]:enable_system_ssh" "Disable:disable_system_ssh" "← Back")
  else
      menu_ssh_server=("Enable:enable_system_ssh" "[Disabled]:disable_system_ssh" "← Back")
  fi
}
update_current_ssh_menu() {
  current_ssh_status=$(/etc/init.d/sshd status 2>/dev/null)
  if [[ $current_ssh_status == "running" ]]; then
    menu_current_ssh=("[Start SSH]:start_ssh" "Stop SSH:stop_ssh" "← Back")
  else
    menu_current_ssh=("Start SSH:start_ssh" "[Stop SSH]:stop_ssh" "← Back")
  fi
}

update_current_ntp_menu() {
  current_ntp_status="$(/etc/init.d/sysntpd status 2>/dev/null)"
  if [[ $current_ntp_status == "running" ]]; then
    menu_current_ntp=("[Start NTP]:start_ntp" "Stop NTP:stop_ntp" "Sync:sync_ntp" "← Back")
  else
    menu_current_ntp=("Start NTP:start_ntp" "[Stop NTP]:stop_ntp" "Sync:sync_ntp" "← Back")
  fi
}

update_current_c2_menu() {
  current_cc_client_status="$(/etc/init.d/cc-client status 2>/dev/null)"
  if [[ $current_cc_client_status == "running" ]]; then
    menu_current_c2=("[Start Client]:start_c2" "Stop Client:stop_c2" "← Back")
  else
    menu_current_c2=("Start Client:start_c2" "[Stop Client]:stop_c2" "← Back")
  fi
}

update_boot_mac_menu() {
  current_boot_mac="$(GET_CONFIG_OPTION MAC_ADDRESS)"
  if [[ $current_boot_mac == "DEFAULT" ]]; then
    menu_boot_mac=("[Default]:set_default_boot_mac" "Static:set_static_boot_mac" "Random:set_random_boot_mac" "← Back" )
  elif [[ $current_boot_mac == "RANDOM" ]]; then
    menu_boot_mac=("Default:set_default_boot_mac" "[Static]:set_static_boot_mac" "[Random]:set_random_boot_mac" "← Back" )
  else
    menu_boot_mac=("[Default]:set_default_boot_mac" "[Static]:set_static_boot_mac" "Random:set_random_boot_mac" "← Back" )
  fi
}

