#                                    ▓▒░▒▒▒▒▒▒▓
#                                       ▒▒▒▒▒▓▓█

RESTARTED_INTERACTIVELY="${1:-false}"

LOCKFILE="/tmp/shark_framework.lock"
# Attempt to acquire the lock
exec 200>$LOCKFILE
# Use flock to create a lock, non-blocking (-n) mode
if ! flock -n 200; then
    echo "Another instance of the shark service is already running. Exiting."
    logger -t Shark "Duplicate Shark service prevented from being started"
    exit 1
fi

framework_cleanup() {
    rm -f "$LOCKFILE"
    killall button_listener 2&>/dev/null
    if [ -f "/tmp/framework_button_listener" ]; then
      rm /tmp/framework_button_listener 2&>/dev/null
    fi
    exit 0
}

trap framework_cleanup SIGINT SIGTERM
trap framework_cleanup EXIT

source /usr/lib/shark_helpers
source /usr/lib/spinner_tools
disable_cursor_blink

