update_about_system_menu() {
  local power_state uptime firmware_version system_time system_date current_led
  power_state=$(/usr/bin/BATTERY 2>/dev/null)
  uptime=$(uptime| awk '{print $3}')
  firmware_version=$(cat /root/VERSION 2>/dev/null || echo "1.0.0")
  system_time=$(/bin/date "+%H:%M:%S")
  system_date=$(/bin/date "+%Y-%m-%d")
  current_led=$(/usr/bin/GET_LED)
  if [ "$power_state" = "Charging" ]; then
    power_state="Y"
  else
    power_state="N"
  fi

  menu_about_system=(
    "Version: $firmware_version"
    "Charging: $power_state"
    "Date: $system_date"
    "Time: $system_time"
    "Uptime: $uptime"
    "LED: $current_led"
    "← Back"
  )
}

update_about_networking_menu() {
  local IFACE current_ip current_subnet current_gateway current_total_rx current_total_tx current_ssh_connections netmode leases
  IFACE="eth0"
  current_ip=$(ifconfig $IFACE | grep 'inet addr:' | awk '{print $2}' | cut -d: -f2)
  current_subnet="/$(ip -4 addr show $IFACE | awk '/inet / {print $2}' | cut -d'/' -f2)"
  current_gateway=$(ip route | awk '/default/ {print $3}')
  current_total_rx="$(cat /sys/class/net/$IFACE/statistics/rx_bytes)"
  current_total_tx="$(cat /sys/class/net/$IFACE/statistics/tx_bytes)"
  current_ssh_connections=$(netstat -tn | grep ':22' | grep 'ESTABLISHED' | wc -l)
  netmode="$(cat /tmp/NETMODE)"
  leases="$(cat /var/dhcp.leases| wc -l)"
  link_state="$(ip link show eth0 | awk '/state/ {print $9}')"
  hostname="$(uci get system.@system[0].hostname)"
  menu_about_networking=(
    "Mode:$netmode"
    "IP:$current_ip"
    "Link: $link_state"
    "Hostname: $hostname"
    "Subnet:$current_subnet"
    "GW:$current_gateway"
    "RX: $current_total_rx"
    "TX: $current_total_tx"
    "Leases: $leases"
    "Shells: $current_ssh_connections"
    "← Back"
  )
}

update_about_services_menu() {
  local cloud_c2_status cloud_c2_boot_status service_mode ssh_status ssh_on_boot ssh_arming_mode
  cloud_c2_status=$([ -f /etc/device.config ] && echo "Y" || echo "N")
  cloud_c2_boot_status=$([ "$config_c2_enabled" = "TRUE" ] && echo "Y" || echo "N")
  ssh_status=$([ "$(/etc/init.d/sshd status)" = "running" ] && echo "Y" || echo "N" )
  ssh_on_boot=$([ "$config_ssh_enabled" = "TRUE" ] && echo "Y" || echo "N")
  ssh_arming_mode=$([ "$config_armingmode_ssh" = "TRUE" ] && echo "Y" || echo "N")
  ntp_status=$([ "$(/etc/init.d/sysntpd status)" = "running" ] && echo "Y" || echo "N" )
  ntp_on_boot=$([ "$config_ntp_enabled" = "TRUE" ] && echo "Y" || echo "N")
  if [ "$SSH_CONTEXT" = "true" ]; then
    service_mode="ssh"
  else
    service_mode="init"
  fi
  menu_about_services=(
    "SSH: $ssh_status"
    "SSH on Boot: $ssh_on_boot"
    "Arming SSH: $ssh_arming_mode"
    "NTP: $ntp_status"
    "NTP on Boot: $ntp_on_boot"
    "Cloud C²: $cloud_c2_status"
    "C² on Boot: $cloud_c2_boot_status"
    "Shark: $service_mode"
    "← Back"
  )
}

update_about_storage_menu() {
  local free_disk payload_count opkg_count loot_count
  free_disk=$(df -h / | awk 'NR==2 {print $4}')
  payload_count=$(tree /root/library/ | grep payload.txt | wc -l)
  opkg_count=$(opkg list-installed | wc -l)
  loot_count=$(tree /root/loot/ | grep files | awk '{print $3}')
  menu_about_storage=(
    "Free: $free_disk"
    "Payloads: $payload_count"
    "Loot: $loot_count"
    "Packages: $opkg_count"
    "← Back"
  )
}

update_default_payload_menu() {
  payload_path="/root/payload"
  payload="${1:-$(find "${payload_path}"/payload* 2>/dev/null | tail -n1)}"
  case $(basename "${payload}") in
    "payload" | "payload.sh" | "payload.txt")
      menu_default_payload=( "Run Payload:launch_armed_payload" "Remove Payload:remove_armed_payload" "← Back" )
      ;;
    *)
      menu_default_payload=( "No Armed Payload:go_back" "← Back" )
      ;;
  esac
}

update_screensaver_menu() {
  config_ss="$(GET_CONFIG_OPTION SCREENSAVER)"
  screensavers=()
  for path in /usr/lib/screensavers/*/; do
      [ -d "$path" ] && screensavers+=("${path%/}")  # Remove trailing slash
  done
  for i in "${!screensavers[@]}"; do
      screensavers[$i]="${screensavers[$i]##*/}"
  done
  menu_screensaver_style=()
  for ss in "${screensavers[@]}"; do
      if [ "$ss" = "$config_ss" ]; then
          menu_screensaver_style+=("[${ss^}]:set_ss")
      else
          menu_screensaver_style+=("${ss^}:set_ss")
      fi
  done
  menu_screensaver_style+=("← Back")
}

update_theme_menu() {
  if [[ $config_theme == "LIGHT" ]]; then
    menu_theme=("[LIGHT]:set_light_mode" "DARK:set_dark_mode" "← Back")
  else
    menu_theme=("LIGHT:set_light_mode" "[DARK]:set_dark_mode" "← Back")
  fi
}

