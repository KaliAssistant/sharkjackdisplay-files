netmode_dhcp_client() {
  resp="$(OPTION_DIALOG "Wait for and display IP?" " No " " Yes ")"
  CREATE_SPINNER "Starting DHCP Client"
  NETMODE DHCP_CLIENT
  update_menu_labels "force"
  STOP_SPINNER
  BLOCKING_ALERT "Complete!" 1 false
  if [ "$resp" = " Yes " ]; then
    newip="$(WAIT_FOR_IP true)"
    if [ "$newip" = "Cancelled" ]; then
      ALERT "Cancelled" 2 false
    else
      ALERT "$newip" -1 false
    fi
  fi
}

