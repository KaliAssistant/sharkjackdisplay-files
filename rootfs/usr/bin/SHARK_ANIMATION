#!/bin/bash

# This script plays an ASCII Shark Animation

echo -e "\033[?25l" > /dev/tty0
echo -en "\033[2J\033[H" > /dev/tty0; sleep 0.3
echo -en "\033[2J\033[H\n\n_\n<\n" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n__\n°<\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n___\n_°<\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n____\n__°<\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n_____\n __°<\n/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n\_____\n_ __°<\n)/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n)\_____\n__ __°<\n )/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n_)\_____\n___ __°<\n  )/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n__)\_____\n____ __°<\n   )/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n___'\_____\nv____ __°<\n    ,/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n____'\_____\n-v____ __°<\n     ,/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n_____'\_____\n--v____ __°<\n      ,/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n\_____)\_____\n/--v____ __°<\n       )/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n \_____)\_____\n /--v____ __°<\n        )/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n  )_____)\_____\n  )--v____ __°<\n         )/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n   )_____'\_____\n   )--v____ __°<\n          ,/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n    )_____'\____\n   S)--v____ __°\n           ,/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n     \_____'\___\n   Sh/--v____ __\n            ,/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n      \_____)\__\n   Sha/--v____ _\n             )/" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n       \_____)\_\n   Shar/--v____ \n              )/" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n        )_____)\\n   Shark)--v____\n               )" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n         )_____'\n   Shark )--v___\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n          )_____\n   Shark J)--v__\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n           \____\n   Shark Ja/--v_\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n            \___\n   Shark Jac/--v\n" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n             \__\n   Shark Jac /--\n" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n              )_\n   Shark Jack )-\n" > /dev/tty0; sleep 0.1
echo -en "\033[2J\033[H\n\n               )\n   Shark Jack  )\n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n                \n   Shark Jack   \n" > /dev/tty0; sleep 0.7
echo -en "\033[2J\033[H\n\n                \n   Shark Jack   \n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n                \n   Shark Jack   \n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n                \n   Shark Jack   \n" > /dev/tty0; sleep 0.05
echo -en "\033[2J\033[H\n\n                \n   Shark Jack   \n" > /dev/tty0; sleep 0.05
