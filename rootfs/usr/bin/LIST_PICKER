#!/bin/bash

# This script will prompt user to select an option from a predefined list
# LIST_PICKER  <title> <space delimited list> <default value>
# This script will echo selected value, or ← Back upon selection

# Usage
# LIST_PICKER "Timeout" "1s 2s 3s 4s 5s 10s 15s 30s 60s" "10s"

source /usr/lib/shark_helpers
disable_cursor_blink

title="$(center_text "${1:-List Picker}")"
options="${2}"
default_option="${3:-${options%% *}}"
selected_option=0
in_edit_mode=false

IFS=' ' read -r -a option_list <<< "$options"

default_index=0
for i in "${!option_list[@]}"; do
  if [[ "${option_list[i]}" == "$default_option" ]]; then
    default_index=$i
    break
  fi
done
current_value="$default_option"

render_list_picker() {
  local screen_output

  screen_output+="$title\n"

  if [[ $selected_option -eq 0 ]]; then
    screen_output+="\n$(center_text "       ▲       ")\n"
  else
    screen_output+="\n\n"
  fi

  local middle_line
  if [[ $in_edit_mode == true ]]; then
    middle_line="\033[7m$(center_text "$current_value")\033[0m"
    screen_output+="$middle_line\n"
  else
    middle_line="$current_value"
    screen_output+="$(center_text "$middle_line")\n"
  fi

  if [[ $selected_option -eq 0 ]]; then
    screen_output+="$(center_text "       ▼       ")\n\n"
  else
    screen_output+="\n\n"
  fi

  local save_option="Save"
  local back_option="← Back"
  if [[ $selected_option -eq 2 ]]; then
    save_option="\033[7mSave\033[0m"
  elif [[ $selected_option -eq 1 ]]; then
    back_option="\033[7m← Back\033[0m"
  fi
  screen_output+="$(center_special_text "$back_option $save_option")"

  clear_screen
  screen_write "$screen_output\n"
}

btn_list_picker_input() {
  local button_input=$1

  case "$button_input" in
    "switch-middle")
      if [[ $selected_option -eq 0 ]]; then
        in_edit_mode=$([[ $in_edit_mode == false ]] && echo true || echo false)
      elif [[ $selected_option -eq 2 ]]; then
        save_current_value
      elif [[ $selected_option -eq 1 ]]; then
        handle_back
      fi
      ;;
    "switch-left")
      if [[ $in_edit_mode == true ]]; then
        default_index=$(( (default_index - 1 + ${#option_list[@]}) % ${#option_list[@]} ))
        current_value="${option_list[$default_index]}"
      else
        selected_option=$((selected_option + 1))
        [[ $selected_option -gt 2 ]] && selected_option=0
      fi
      ;;
    "switch-right")
      if [[ $in_edit_mode == true ]]; then
        default_index=$(( (default_index + 1) % ${#option_list[@]} ))
        current_value="${option_list[$default_index]}"
      else
        selected_option=$((selected_option - 1))
        [[ $selected_option -lt 0 ]] && selected_option=2
      fi
      ;;
  esac
}

save_current_value() {
  exit_picker=true
  echo "$current_value"
}

handle_back() {
  exit_picker=true
  echo "← Back"
}

list_picker() {
  exit_picker=false
  while [[ $exit_picker == false ]]; do
    render_list_picker
    button_input=$(/usr/sbin/dialog_button_listener)
    btn_list_picker_input "$button_input"
  done
}

echo "LIST_PICKER" >> /tmp/suppress_screen_service_scroll
list_picker
rm /tmp/suppress_screen_service_scroll
