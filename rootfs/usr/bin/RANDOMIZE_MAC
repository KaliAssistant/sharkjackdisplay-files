#!/bin/bash

# This script can be used to randomize the MAC of the device
# and then display the new MAC

# will toggle eth0 network interface

source /usr/lib/spinner_tools

CREATE_SPINNER "Randomizing Mac..."
sleep 1
ifconfig eth0 down
macchanger -r eth0
ifconfig eth0 up
STOP_SPINNER
ALERT "Complete!" 2 false
mac="$(ip link show eth0 | awk '/ether/ {print $2}' | sed 's/://g')"
ALERT "$mac" -1 false
